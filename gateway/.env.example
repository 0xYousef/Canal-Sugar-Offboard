# Copy to .env in this folder, then: npm install && npm start
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net
API_KEY=change-me
# Where people open the portal (the Windows app uses http://localhost:47321)
ALLOWED_ORIGIN=http://localhost:47321
PORT=8787
# Time zone used for the daily closing time
TZ=Africa/Cairo

# Accounts. The first account (the Owner) is created in the database the first time the gateway is used.
OWNER_EMAIL=owner@canalsugar.com
OWNER_NAME=Owner
# The password new people (and the Owner at first) start with; they must change it at first sign-in.
DEFAULT_PASSWORD=abd@123456
# Optional: secret that signs sign-in sessions (defaults to API_KEY) and how long a sign-in lasts
# SESSION_SECRET=
# SESSION_HOURS=12
