# Copy to .env for local work. On Vercel, add the same names under Project Settings -> Environment Variables.
# Values starting with VITE_ are written into the website files, so anyone can read them. Never put the MongoDB password here.

# Public address of the gateway (see gateway/README.md) and its access key.
VITE_DB_URL=http://localhost:8787
VITE_DB_KEY=change-me

# Optional
VITE_DB_NAME=offboarding
VITE_DB_COLLECTION=app_state
